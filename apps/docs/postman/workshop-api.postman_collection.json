{
  "info": {
    "_postman_id": "workshop-api-collection-v1",
    "name": "Workshop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "attachmentId", "value": "" },
    { "key": "sampleId", "value": "" },
    { "key": "materialId", "value": "" },
    { "key": "orderLineId", "value": "" },
    { "key": "holdId", "value": "" },
    { "key": "workshopId", "value": "" },
    { "key": "batchId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"o12345678\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Presign Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('attachmentId', body.attachmentId);",
                  "  pm.collectionVariables.set('attachmentId', body.attachmentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mimeType\": \"image/jpeg\",\n  \"sizeBytes\": 120000,\n  \"purpose\": \"order\"\n}"
            },
            "url": "{{baseUrl}}/files/presign"
          }
        },
        {
          "name": "Confirm Upload",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/files/{{attachmentId}}/confirm"
          }
        },
        {
          "name": "Get Signed URL",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/files/{{attachmentId}}/url"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('customerId', body.id);",
                  "  pm.collectionVariables.set('customerId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"أحمد\",\n  \"phone\": \"0999111222\",\n  \"note\": \"زبون جملة\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers?search=",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [{ "key": "search", "value": "", "disabled": true }]
            }
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"ملاحظة محدثة\"\n}"
            },
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('orderId', body.id);",
                  "  pm.collectionVariables.set('orderId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"title\": \"قميص أبيض صيفي\",\n  \"note\": \"حسب الصورة المرسلة\"\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}",
                  "disabled": true
                },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Update Step (CLOTH -> DONE)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\",\n  \"note\": \"تم اختيار القماش\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/steps/CLOTH"
          }
        },
        {
          "name": "Update Step (CUTTING -> IN_PROGRESS, expect 400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/steps/CUTTING"
          }
        },
        {
          "name": "Reorder Steps (CLOTH first)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": [\n    \"CLOTH\",\n    \"ACCESSORIES\",\n    \"PATTERN\",\n    \"SAMPLE\",\n    \"CUTTING\",\n    \"WORKSHOP\",\n    \"FINISHING\",\n    \"FINAL_CHECK\",\n    \"DELIVERY\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/steps/reorder"
          }
        }
      ]
    },
    {
      "name": "Design (Pattern & Sample)",
      "item": [
        {
          "name": "Create Pattern",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"باترون أولي\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/patterns"
          }
        },
        {
          "name": "List Patterns",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}/patterns"
          }
        },
        {
          "name": "Create Sample",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('sampleId', body.id);",
                  "  pm.collectionVariables.set('sampleId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"عينة أولى للزبون\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/samples"
          }
        },
        {
          "name": "Reject Sample",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECTED\",\n  \"note\": \"الكم يحتاج تعديل\"\n}"
            },
            "url": "{{baseUrl}}/samples/{{sampleId}}/decision"
          }
        },
        {
          "name": "Approve Sample",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"note\": \"موافق عليها\"\n}"
            },
            "url": "{{baseUrl}}/samples/{{sampleId}}/decision"
          }
        },
        {
          "name": "List Samples",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}/samples"
          }
        },
        {
          "name": "Materials & Inventory",
          "item": [
            {
              "name": "Create Material (Fabric)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  pm.environment.set('materialId', body.id);",
                      "  pm.collectionVariables.set('materialId', body.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"kind\": \"FABRIC\",\n  \"name\": \"قطن تركي\",\n  \"color\": \"أبيض\",\n  \"unit\": \"متر\",\n  \"unitCostMinor\": 50000\n}"
                },
                "url": "{{baseUrl}}/materials"
              }
            },
            {
              "name": "Stock IN (+100)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"type\": \"IN\",\n  \"quantity\": 100,\n  \"note\": \"شراء رول جديد\"\n}"
                },
                "url": "{{baseUrl}}/materials/{{materialId}}/movements"
              }
            },
            {
              "name": "List Materials (with currentStock)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/materials"
              }
            },
            {
              "name": "Reserve Material on Order (-25)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"kind\": \"FABRIC\",\n  \"materialId\": \"{{materialId}}\",\n  \"quantity\": 25,\n  \"deductFromStock\": true,\n  \"note\": \"قماش الطلب\"\n}"
                },
                "url": "{{baseUrl}}/orders/{{orderId}}/materials"
              }
            },
            {
              "name": "Add Custom Accessory to Order",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"kind\": \"ACCESSORY\",\n  \"customName\": \"زر صدفي خاص\",\n  \"customColor\": \"أبيض\",\n  \"quantity\": 200,\n  \"unit\": \"حبة\"\n}"
                },
                "url": "{{baseUrl}}/orders/{{orderId}}/materials"
              }
            },
            {
              "name": "List Order Materials",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/orders/{{orderId}}/materials"
              }
            }
          ]
        },
        {
          "name": "Production (Lines, Cutting & Holds)",
          "item": [
            {
              "name": "Upsert Order Lines",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  if (Array.isArray(body) && body.length > 0) {",
                      "    pm.environment.set('orderLineId', body[0].id);",
                      "    pm.collectionVariables.set('orderLineId', body[0].id);",
                      "  }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"lines\": [\n    { \"color\": \"أبيض\", \"size\": \"M\", \"orderedQty\": 50 },\n    { \"color\": \"أبيض\", \"size\": \"L\", \"orderedQty\": 30 }\n  ]\n}"
                },
                "url": "{{baseUrl}}/orders/{{orderId}}/lines"
              }
            },
            {
              "name": "Record Cutting (47 of 50)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"entries\": [\n    { \"orderLineId\": \"{{orderLineId}}\", \"quantity\": 47, \"note\": \"نقص قماش لـ 3 قطع\" }\n  ]\n}"
                },
                "url": "{{baseUrl}}/orders/{{orderId}}/cutting"
              }
            },
            {
              "name": "Create Hold (3 missing)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  pm.environment.set('holdId', body.id);",
                      "  pm.collectionVariables.set('holdId', body.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"orderLineId\": \"{{orderLineId}}\",\n  \"stage\": \"CUTTING\",\n  \"quantity\": 3,\n  \"reason\": \"نقص قماش أبيض\"\n}"
                },
                "url": "{{baseUrl}}/orders/{{orderId}}/holds"
              }
            },
            {
              "name": "Get Production Board",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/orders/{{orderId}}/production"
              }
            },
            {
              "name": "Resolve Hold",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"resolutionNote\": \"وصل القماش وتم قص الـ 3 قطع\"\n}"
                },
                "url": "{{baseUrl}}/holds/{{holdId}}/resolve"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Workshops (مشغل & Ledger)",
      "item": [
        {
          "name": "Create Workshop",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('workshopId', body.id);",
                  "  pm.collectionVariables.set('workshopId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"مشغل النور\",\n  \"phone\": \"0999333444\"\n}"
            },
            "url": "{{baseUrl}}/workshops"
          }
        },
        {
          "name": "Send Cut Pieces to Workshop (40 pcs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('batchId', body.id);",
                  "  pm.collectionVariables.set('batchId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderLineId\": \"{{orderLineId}}\",\n  \"workshopId\": \"{{workshopId}}\",\n  \"sentQty\": 40,\n  \"ratePerPieceMinor\": 15000,\n  \"note\": \"دفعة أولى\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/workshop-batches"
          }
        },
        {
          "name": "Receive Pieces from Workshop (25 pcs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 25,\n  \"note\": \"استلام جزئي\"\n}"
            },
            "url": "{{baseUrl}}/workshop-batches/{{batchId}}/receive"
          }
        },
        {
          "name": "Record Workshop Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountMinor\": 200000,\n  \"note\": \"دفعة نقدية\"\n}"
            },
            "url": "{{baseUrl}}/workshops/{{workshopId}}/payments"
          }
        },
        {
          "name": "Get Workshop (Balance & Batches)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workshops/{{workshopId}}"
          }
        }
      ]
    }
  ]
}
