// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String
  fullName     String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)
  refreshTokens RefreshToken[]
  attachments Attachment[]
  customersCreated Customer[] @relation("CustomerCreatedBy")
  ordersCreated    Order[]    @relation("OrderCreatedBy")
  patternsCreated  Pattern[]  @relation("PatternCreatedBy")
  samplesCreated   Sample[]   @relation("SampleCreatedBy")
  samplesDecided   Sample[]   @relation("SampleDecidedBy")
  materialsCreated      Material[]      @relation("MaterialCreatedBy")
  stockMovementsCreated StockMovement[] @relation("StockMovementCreatedBy")
  orderMaterialsCreated OrderMaterial[] @relation("OrderMaterialCreatedBy")
  cuttingRecordsCreated CuttingRecord[] @relation("CuttingCreatedBy")
  holdsCreated          Hold[]          @relation("HoldCreatedBy")
  holdsResolved         Hold[]          @relation("HoldResolvedBy")
  workshopsCreated       Workshop[]             @relation("WorkshopCreatedBy")
  workshopBatchesCreated WorkshopBatch[]        @relation("WorkshopBatchCreatedBy")
  workshopReceiptsCreated WorkshopBatchReceipt[] @relation("WorkshopReceiptCreatedBy")
  workshopLedgerCreated  WorkshopLedgerEntry[]  @relation("WorkshopLedgerCreatedBy")
  finishingRecordsCreated FinishingRecord[] @relation("FinishingCreatedBy")
  qualityChecksCreated    QualityCheck[]    @relation("QualityCheckCreatedBy")
  deliveriesCreated       Delivery[]        @relation("DeliveryCreatedBy")
  returnsCreated          Return[]          @relation("ReturnCreatedBy")
  invoicesCreated         Invoice[]         @relation("InvoiceCreatedBy")
  customerPaymentsCreated CustomerPayment[] @relation("CustomerPaymentCreatedBy")
  expensesCreated         Expense[]         @relation("ExpenseCreatedBy")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}



enum AttachmentStatus {
  PENDING
  READY
}

model Attachment {
  id                 String              @id @default(uuid()) @db.Uuid
  key                String              @unique
  mimeType           String
  sizeBytes          Int
  purpose            String
  status             AttachmentStatus    @default(PENDING)
  createdById        String              @db.Uuid
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  version            Int                 @default(1)
  orderAttachments   OrderAttachment[]
  patternAttachments PatternAttachment[]
  sampleAttachments  SampleAttachment[]
  materialImages      Material[]      @relation("MaterialImage")
  orderMaterialImages OrderMaterial[] @relation("OrderMaterialImage")
  orderStepAttachments OrderStepAttachment[]
}


enum OrderStepType {
  PATTERN
  SAMPLE
  ACCESSORIES
  CLOTH
  CUTTING
  WORKSHOP
  FINISHING
  FINAL_CHECK
  DELIVERY
}

enum OrderStepStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

enum SampleStatus {
  PENDING
  APPROVED
  REJECTED
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  phone       String?
  note        String?
  orders      Order[]
  createdById String    @db.Uuid
  createdBy   User      @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)
  invoices Invoice[]
}

model Order {
  id          String            @id @default(uuid()) @db.Uuid
  orderNumber String            @unique
  customerId  String            @db.Uuid
  customer    Customer          @relation(fields: [customerId], references: [id])
  title       String?
  note        String?
  steps       OrderStep[]
  attachments OrderAttachment[]
  patterns    Pattern[]
  samples     Sample[]
  createdById String            @db.Uuid
  createdBy   User              @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  version     Int               @default(1)
  stockMovements StockMovement[]
  materials      OrderMaterial[]
  lines OrderLine[]
  holds Hold[]
  workshopBatches WorkshopBatch[]
  deliveries Delivery[]
  returns    Return[]
  invoices Invoice[]
  expenses Expense[]
}

model OrderAttachment {
  orderId      String     @db.Uuid
  attachmentId String     @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id])
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([orderId, attachmentId])
}

model OrderStep {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id])
  type      OrderStepType
  status    OrderStepStatus @default(NOT_STARTED)
  sortOrder Int             @default(0)
  note      String?
  startedAt DateTime?
  doneAt    DateTime?
  updatedAt DateTime        @updatedAt
  version   Int             @default(1)
  attachments OrderStepAttachment[]
  @@unique([orderId, type])
}

model Pattern {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String              @db.Uuid
  order       Order               @relation(fields: [orderId], references: [id])
  versionNum  Int
  note        String?
  attachments PatternAttachment[]
  createdById String              @db.Uuid
  createdBy   User                @relation("PatternCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  version     Int                 @default(1)

  @@unique([orderId, versionNum])
}

model PatternAttachment {
  patternId    String     @db.Uuid
  attachmentId String     @db.Uuid
  pattern      Pattern    @relation(fields: [patternId], references: [id])
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([patternId, attachmentId])
}

model Sample {
  id          String             @id @default(uuid()) @db.Uuid
  orderId     String             @db.Uuid
  order       Order              @relation(fields: [orderId], references: [id])
  attemptNum  Int
  status      SampleStatus       @default(PENDING)
  note        String?
  decisionNote String?
  decidedAt   DateTime?
  decidedById String?            @db.Uuid
  decidedBy   User?              @relation("SampleDecidedBy", fields: [decidedById], references: [id])
  attachments SampleAttachment[]
  createdById String             @db.Uuid
  createdBy   User               @relation("SampleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  version     Int                @default(1)

  @@unique([orderId, attemptNum])
}

model SampleAttachment {
  sampleId     String     @db.Uuid
  attachmentId String     @db.Uuid
  sample       Sample     @relation(fields: [sampleId], references: [id])
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([sampleId, attachmentId])
}


enum MaterialKind {
  FABRIC
  ACCESSORY
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model Material {
  id            String          @id @default(uuid()) @db.Uuid
  kind          MaterialKind
  name          String
  color         String?
  unit          String          // e.g. "meter", "kg", "piece"
  unitCostMinor Int?            // minor currency units (e.g. cents/piasters)
  attachmentId  String?         @db.Uuid
  attachment    Attachment?     @relation("MaterialImage", fields: [attachmentId], references: [id])
  note          String?
  movements     StockMovement[]
  orderUsages   OrderMaterial[]
  createdById   String          @db.Uuid
  createdBy     User            @relation("MaterialCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  version       Int             @default(1)
}


model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  materialId  String            @db.Uuid
  material    Material          @relation(fields: [materialId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  orderId     String?           @db.Uuid
  order       Order?            @relation(fields: [orderId], references: [id])
  note        String?
  createdById String            @db.Uuid
  createdBy   User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([materialId])
  @@index([orderId])
}

model OrderMaterial {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @db.Uuid
  order              Order        @relation(fields: [orderId], references: [id])
  kind               MaterialKind
  materialId         String?      @db.Uuid
  material           Material?    @relation(fields: [materialId], references: [id])
  customName         String?
  customColor        String?
  customAttachmentId String?      @db.Uuid
  customAttachment   Attachment?  @relation("OrderMaterialImage", fields: [customAttachmentId], references: [id])
  quantity           Decimal      @db.Decimal(12, 3)
  unit               String
  note               String?
  createdById        String       @db.Uuid
  createdBy          User         @relation("OrderMaterialCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  version            Int          @default(1)

  @@index([orderId, kind])
}


enum HoldStatus {
  OPEN
  RESOLVED
}

model OrderLine {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @db.Uuid
  order          Order           @relation(fields: [orderId], references: [id])
  color          String
  size           String
  orderedQty     Int
  cuttingRecords CuttingRecord[]
  holds          Hold[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  version        Int             @default(1)
  workshopBatches WorkshopBatch[]
  finishingRecords FinishingRecord[]
  qualityChecks    QualityCheck[]
  deliveryItems    DeliveryItem[]
  returnItems      ReturnItem[]
  @@unique([orderId, color, size])
  @@index([orderId])
}

model CuttingRecord {
  id          String    @id @default(uuid()) @db.Uuid
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  // Positive for pieces cut, negative for a count correction
  quantity    Int
  note        String?
  createdById String    @db.Uuid
  createdBy   User      @relation("CuttingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderLineId])
}

model Hold {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id])
  orderLineId    String        @db.Uuid
  orderLine      OrderLine     @relation(fields: [orderLineId], references: [id])
  stage          OrderStepType
  quantity       Int
  reason         String
  status         HoldStatus    @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?       @db.Uuid
  resolvedBy     User?         @relation("HoldResolvedBy", fields: [resolvedById], references: [id])
  createdById    String        @db.Uuid
  createdBy      User          @relation("HoldCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  version        Int           @default(1)

  @@index([orderId, status])
  @@index([orderLineId])
}

enum WorkshopLedgerEntryType {
  CHARGE
  PAYMENT
  ADJUST
}

model Workshop {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  phone         String?
  address       String?
  note          String?
  batches       WorkshopBatch[]
  ledgerEntries WorkshopLedgerEntry[]
  createdById   String                @db.Uuid
  createdBy     User                  @relation("WorkshopCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  version       Int                   @default(1)
}

model WorkshopBatch {
  id                String                 @id @default(uuid()) @db.Uuid
  orderId           String                 @db.Uuid
  order             Order                  @relation(fields: [orderId], references: [id])
  orderLineId       String                 @db.Uuid
  orderLine         OrderLine              @relation(fields: [orderLineId], references: [id])
  workshopId        String                 @db.Uuid
  workshop          Workshop               @relation(fields: [workshopId], references: [id])
  sentQty           Int
  ratePerPieceMinor Int                    // minor currency units per received piece
  note              String?
  receipts          WorkshopBatchReceipt[]
  ledgerEntries     WorkshopLedgerEntry[]
  createdById       String                 @db.Uuid
  createdBy         User                   @relation("WorkshopBatchCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  version           Int                    @default(1)

  @@index([orderId])
  @@index([orderLineId])
  @@index([workshopId])
}

model WorkshopBatchReceipt {
  id          String        @id @default(uuid()) @db.Uuid
  batchId     String        @db.Uuid
  batch       WorkshopBatch @relation(fields: [batchId], references: [id])
  quantity    Int
  note        String?
  createdById String        @db.Uuid
  createdBy   User          @relation("WorkshopReceiptCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([batchId])
}

model WorkshopLedgerEntry {
  id          String                  @id @default(uuid()) @db.Uuid
  workshopId  String                  @db.Uuid
  workshop    Workshop                @relation(fields: [workshopId], references: [id])
  type        WorkshopLedgerEntryType
  // Positive for CHARGE (we owe workshop), negative for PAYMENT (we paid workshop)
  amountMinor Int
  batchId     String?                 @db.Uuid
  batch       WorkshopBatch?          @relation(fields: [batchId], references: [id])
  note        String?
  createdById String                  @db.Uuid
  createdBy   User                    @relation("WorkshopLedgerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([workshopId])
  @@index([batchId])
}

enum ReturnDisposition {
  RESTOCK
  REPAIR
  WRITE_OFF
}

model FinishingRecord {
  id          String    @id @default(uuid()) @db.Uuid
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  quantity    Int
  note        String?
  createdById String    @db.Uuid
  createdBy   User      @relation("FinishingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderLineId])
}

model QualityCheck {
  id          String    @id @default(uuid()) @db.Uuid
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  passedQty   Int
  rejectedQty Int       @default(0)
  note        String?
  createdById String    @db.Uuid
  createdBy   User      @relation("QualityCheckCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderLineId])
}

model Delivery {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @db.Uuid
  order       Order          @relation(fields: [orderId], references: [id])
  note        String?
  items       DeliveryItem[]
  createdById String         @db.Uuid
  createdBy   User           @relation("DeliveryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([orderId])
}

model DeliveryItem {
  id          String    @id @default(uuid()) @db.Uuid
  deliveryId  String    @db.Uuid
  delivery    Delivery  @relation(fields: [deliveryId], references: [id])
  orderLineId String    @db.Uuid
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  quantity    Int

  @@index([deliveryId])
  @@index([orderLineId])
}

model Return {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  order       Order        @relation(fields: [orderId], references: [id])
  reason      String?
  items       ReturnItem[]
  createdById String       @db.Uuid
  createdBy   User         @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

model ReturnItem {
  id          String            @id @default(uuid()) @db.Uuid
  returnId    String            @db.Uuid
  return      Return            @relation(fields: [returnId], references: [id])
  orderLineId String            @db.Uuid
  orderLine   OrderLine         @relation(fields: [orderLineId], references: [id])
  quantity    Int
  disposition ReturnDisposition
  note        String?

  @@index([returnId])
  @@index([orderLineId])
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @db.Uuid
  order       Order             @relation(fields: [orderId], references: [id])
  customerId  String            @db.Uuid
  customer    Customer          @relation(fields: [customerId], references: [id])
  totalMinor  Int
  status      InvoiceStatus     @default(ISSUED)
  note        String?
  payments    CustomerPayment[]
  createdById String            @db.Uuid
  createdBy   User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  version     Int               @default(1)

  @@index([orderId])
  @@index([customerId])
}

model CustomerPayment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountMinor Int
  method      String?  // e.g. "cash", "transfer"
  note        String?
  createdById String   @db.Uuid
  createdBy   User     @relation("CustomerPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Expense {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String?   @db.Uuid
  order       Order?    @relation(fields: [orderId], references: [id])
  category    String    // e.g. "transport", "packaging", "other"
  amountMinor Int
  note        String?
  createdById String    @db.Uuid
  createdBy   User      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([orderId])
}


model OrderStepAttachment {
  orderStepId  String     @db.Uuid
  attachmentId String     @db.Uuid
  orderStep    OrderStep  @relation(fields: [orderStepId], references: [id])
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([orderStepId, attachmentId])
}